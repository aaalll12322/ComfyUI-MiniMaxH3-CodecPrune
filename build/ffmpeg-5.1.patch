+/* Residual output (see h264idct_template.c): an n x n luma block without coded coefficients is set to 128. */
+static av_always_inline void fill_zero_residual(uint8_t *dst, int n, int linesize, int pixel_shift)
+{
+    for (int y = 0; y < n; y++) {
+        if (pixel_shift)
+            for (int x = 0; x < n; x++)
+                ((uint16_t *)(dst + y * linesize))[x] = 128;
+        else
+            memset(dst + y * linesize, 128, n);
+    }
+}
